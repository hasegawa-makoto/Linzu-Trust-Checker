{
  "manifest_version": 3,
  "name": "Linzu Trust Checker",
  "version": "1.0",
  "description": "Check the trustworthiness of the current page with Linzu.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/exif.js", "libs/api_client.js", "libs/image_forensics.js", "content.js"]
    }
  ]
}
